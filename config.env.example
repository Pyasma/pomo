# pomo configuration. Values are shell variables.
WORK_MIN=45
BREAK_MIN=15
LONG_MIN=15
CYCLES=4          # work sessions before a long break
AUTO_BREAK=1      # start break automatically when work ends
AUTO_WORK=0       # start next work session automatically when break ends
NAG_MIN=30        # minutes between idle nudges (0 disables)
SOUND_END=/usr/share/sounds/freedesktop/stereo/complete.oga
SOUND_START=/usr/share/sounds/freedesktop/stereo/message.oga
SOUND_DUE=/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga
WAYBAR_SIGNAL=11
GOAL=4            # pomodoros that make a day count (0 turns the goal off)
BAR_TIME=0        # 1 = print the minutes next to the waybar clock too

# --- phone mirroring (ntfy) ---
# Urgent alerts (session done, focus done, over budget, task due) also go to your phone.
# Subscribe to this exact topic in the ntfy app to receive them.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=       # your ntfy topic; keep it long and random
PUSH_ALL=0        # 1 = mirror every notification, not just the urgent ones
AGENDA_AT=08:00   # morning push of today's sessions (empty disables)

# --- predefined daily sessions (off) ---
# The session layer reads ~/.config/pomo/sessions.conf and turns pomo into a
# checklist for a planned day. Off by default: pomo is a task and a timer.
#SESSIONS=1
